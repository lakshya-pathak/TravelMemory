# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Windows thumbnail cache
Thumbs.db
# macOS Finder metadata
.DS_Store
# Linux trash files
.Trash-*
# VS Code workspace settings
.vscode/
# JetBrains IDEs
.idea/
# Sublime Text project files
*.sublime-workspace
*.sublime-project

# === Environment & configuration ===
# Local environment files – never commit secrets
.env
.env.*          # e.g. .env.development, .env.production
.env.local
.env.test

# === Dependency folders ===
# Backend (Node) modules
/backend/node_modules/
# Frontend (Node) modules
/frontend/node_modules/
# Yarn Plug’n’Play files (if you ever use Yarn PnP)
.pnp
.pnp.js

# === Build / Distribution artifacts ===
# Backend compiled output (if you ever transpile)
backend/dist/
backend/build/

# Frontend Vite / CRA / Next.js output
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/
frontend/.nuxt/
frontend/public/build/
frontend/.cache/

# === Log / Debug files ===
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/
debug.log

# === Test coverage reports ===
coverage/
lcov-report/
*.lcov

# === Temporary / cache files ===
# npm cache
.npm
# Yarn cache
.yarn
# pnpm store
.pnpm-store
# Miscellaneous temp files
tmp/
temp/
*.tmp

# === IDE / tooling specific ===
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
# Eclipse
.project
.classpath
.csettings/
.settings/
